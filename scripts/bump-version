#!/bin/sh
# pre-commit hook: regenerate cmd/version_gen.go with the next build
# number (commit count + 1) and stage it, so every commit ships its own
# number. Install once with: scripts/install-hooks
set -e
cd "$(git rev-parse --show-toplevel)"
n=$(($(git rev-list --count HEAD 2>/dev/null || echo 0) + 1))
cat > cmd/version_gen.go <<EOF
package cmd

// buildNumber is regenerated by the pre-commit hook (scripts/bump-version)
// — one natural number, +1 on every commit. Do not edit by hand.
const buildNumber = $n
EOF
git add cmd/version_gen.go
